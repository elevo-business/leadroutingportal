# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# API-Key fuer die Inbound Lead API (Header: x-api-key)
# Generieren z. B. mit: openssl rand -hex 32
INBOUND_API_KEY=dein-geheimer-api-key

# Make.com Custom Webhook URL (fuer den Meta CAPI Feedback-Loop)
MAKE_WEBHOOK_URL=https://hook.make.com/deine-webhook-url
